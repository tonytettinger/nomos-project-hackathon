# Required for the browser voice session. The API key remains server-only.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Optional: enables post-conversation structured extraction.
OPENAI_API_KEY=
# Optional: defaults to gpt-5.4-mini.
OPENAI_MODEL=gpt-5.4-mini
# Optional: defaults to 8787.
API_PORT=8787
